# Never bake credentials into a deploy image.
.git
.vercel
.env
.env.*
*.env

# Dependencies are installed in dedicated Docker build stages.
/vendor
/node_modules
/tests
/.phpunit.result.cache
/.phpunit.cache

# Local database snapshots must never become the production database.
/database/*.sqlite
/database/*.sqlite3
/database/*.db

# Runtime-generated data and private local uploads are not deploy artifacts.
/bootstrap/cache/*.php
/storage/framework/cache/data/*
/storage/framework/sessions/*
/storage/framework/views/*.php
/storage/logs/*
/storage/app/public/*
/public/storage
