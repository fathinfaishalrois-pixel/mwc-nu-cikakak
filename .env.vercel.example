# Copy these keys into Vercel Project Settings > Environment Variables.
# Do not commit your real .env or paste secrets into GitHub.
APP_NAME="MWC NU Cikakak"
APP_ENV=production
APP_KEY=base64:GENERATE_A_REAL_KEY_WITH_php_artisan_key_generate
APP_DEBUG=false
APP_URL=https://YOUR-PROJECT.vercel.app
APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID

LOG_CHANNEL=stderr
LOG_LEVEL=warning

# Supabase Connect > Transaction pooler (port 6543) for serverless requests.
DB_CONNECTION=pgsql
DB_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_DB_PASSWORD@YOUR_POOLER_HOST:6543/postgres
DB_SSLMODE=require
DB_SEARCH_PATH=public

# Persistent state must not use the function's ephemeral filesystem.
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
CACHE_STORE=database
QUEUE_CONNECTION=sync
APP_MAINTENANCE_DRIVER=cache
APP_MAINTENANCE_STORE=database

# Supabase Storage > S3 Connection details. Create a PUBLIC media bucket first.
FILESYSTEM_DISK=public
PUBLIC_FILESYSTEM_DRIVER=s3
AWS_ACCESS_KEY_ID=YOUR_SUPABASE_S3_ACCESS_KEY_ID
AWS_SECRET_ACCESS_KEY=YOUR_SUPABASE_S3_SECRET_ACCESS_KEY
AWS_DEFAULT_REGION=YOUR_S3_REGION
AWS_BUCKET=mwc-media
AWS_ENDPOINT=https://YOUR_PROJECT_REF.supabase.co/storage/v1/s3
AWS_URL=https://YOUR_PROJECT_REF.supabase.co/storage/v1/object/public/mwc-media
AWS_USE_PATH_STYLE_ENDPOINT=true

# Optional separate private bucket; do not make it public.
SUPABASE_PRIVATE_BUCKET=mwc-private
